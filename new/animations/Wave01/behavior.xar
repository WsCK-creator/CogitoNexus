                                  <Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" />
                                  <Output name="ppr" type="1" type_size="1" nature="2" inner="0" tooltip="" id="5" />
                                  <Output name="nao" type="1" type_size="1" nature="2" inner="0" tooltip="" id="6" />
