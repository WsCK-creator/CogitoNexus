{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Smart Build Check",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/build_cogito-nexus.ps1",
                "-Module", "check"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "🔨 BUILD: Wymuś Całość (all)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/build_cogito-nexus.ps1",
                "-Module", "all"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "🔨 BUILD: Wymuś Mózg (brain)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/build_cogito-nexus.ps1",
                "-Module", "brain"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "🔨 BUILD: Wymuś Most (bridge)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/build_cogito-nexus.ps1",
                "-Module", "bridge"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}  